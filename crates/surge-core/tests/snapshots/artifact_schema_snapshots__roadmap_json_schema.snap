---
source: crates/surge-core/tests/artifact_schema_snapshots.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoadmapArtifact",
  "description": "Surge `roadmap.toml` artifact: optional missions with validation contracts, ordered milestones, cross-milestone dependencies, and tracked risks.",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Artifact contract schema version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 2
    },
    "missions": {
      "description": "Missions grouping the milestones, in execution order.\n\nOptional. When present, the missions partition [`Self::milestones`]:\nevery milestone belongs to exactly one mission and concatenating the\nmissions' milestone lists reproduces the milestone order. Milestones\nstay a flat list so flows keep iterating `milestones` directly.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoadmapMission"
      }
    },
    "milestones": {
      "description": "Deliverable-focused milestones in execution order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoadmapMilestone"
      },
      "default": []
    },
    "dependencies": {
      "description": "Cross-milestone dependencies.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoadmapDependency"
      },
      "default": []
    },
    "risks": {
      "description": "Known delivery risks.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoadmapRisk"
      },
      "default": []
    }
  },
  "$defs": {
    "RoadmapMission": {
      "description": "A bounded, multi-milestone effort with its own definition of done.\n\nThe validation contract is written before the work is split into tasks,\nso it describes the behaviour the user asked for rather than the\nimplementation already planned. Each assertion is claimed by exactly one\ntask through [`RoadmapTask::fulfills`].",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier, for example `mission-1`.",
          "type": "string"
        },
        "title": {
          "description": "Human-readable mission title.",
          "type": "string"
        },
        "goal": {
          "description": "The outcome this mission delivers, in one or two sentences.",
          "type": "string"
        },
        "status": {
          "description": "Current execution status.",
          "$ref": "#/$defs/RoadmapStatus"
        },
        "milestones": {
          "description": "Ids of the milestones this mission owns, in execution order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_contract": {
          "description": "Behavioural assertions that define the mission as done.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationAssertion"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "title",
        "goal",
        "milestones"
      ]
    },
    "RoadmapStatus": {
      "description": "Execution status of a roadmap item.",
      "oneOf": [
        {
          "description": "Not yet started.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Currently being executed by the orchestrator.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Paused, waiting for human input or gate.",
          "type": "string",
          "const": "paused"
        },
        {
          "description": "Implementation reported done; awaiting a verification-authority node.",
          "type": "string",
          "const": "ready_for_verification"
        },
        {
          "description": "Verification rejected the implementation; routes back to execution.",
          "type": "string",
          "const": "failed_verification"
        },
        {
          "description": "Completed successfully.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "Failed — may be retried.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Skipped (dependency failed or user cancelled).",
          "type": "string",
          "const": "skipped"
        }
      ]
    },
    "ValidationAssertion": {
      "description": "One testable behavioural assertion in a mission's validation contract.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id with an area prefix, for example `VAL-AUTH-001`.",
          "type": "string"
        },
        "title": {
          "description": "Short title.",
          "type": "string"
        },
        "pass_condition": {
          "description": "Observable pass/fail condition, phrased as behaviour a user or test\ncan check.",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence a verifier must capture (test output, screenshot, HTTP\nexchange, log excerpt).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "title",
        "pass_condition"
      ]
    },
    "RoadmapMilestone": {
      "description": "One deliverable-focused roadmap milestone.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable human-authored identifier, for example `m1`.",
          "type": "string"
        },
        "title": {
          "description": "Human-readable milestone title.",
          "type": "string"
        },
        "status": {
          "description": "Current execution status for amendment safety checks.",
          "$ref": "#/$defs/RoadmapStatus"
        },
        "tasks": {
          "description": "Ordered tasks within this milestone.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoadmapTask"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "RoadmapTask": {
      "description": "One task within a roadmap milestone.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable human-authored identifier, for example `m1-t1`.",
          "type": "string"
        },
        "title": {
          "description": "Human-readable task title.",
          "type": "string"
        },
        "status": {
          "description": "Current execution status for amendment safety checks.",
          "$ref": "#/$defs/RoadmapStatus"
        },
        "description": {
          "description": "Optional short description.",
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "description": "Acceptance criteria that downstream spec/story authors can refine.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "depends_on": {
          "description": "Task ids (in any milestone) that must complete before this task.\n\nSchema v2. Task-granularity edges for the ledger; milestone-level\nordering stays in [`RoadmapArtifact::dependencies`].",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discovered_from": {
          "description": "Task id this task was discovered from while executing that task.\n\nSchema v2. Captures mid-task discovered work instead of dropping it.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "Context-budget size class.\n\nSchema v2, required by the validator at v2: every task must be\ncompletable in one fresh agent session; oversized work is split.",
          "anyOf": [
            {
              "$ref": "#/$defs/TaskSize"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified": {
          "description": "True only when a verification-authority node reported the task\nverified. Distinct from [`RoadmapStatus::Completed`], which any\nstage can claim.",
          "type": "boolean"
        },
        "fulfills": {
          "description": "Validation-contract assertion ids this task makes fully testable.\n\nOnly the leaf task that completes an assertion claims it;\ninfrastructure tasks leave this empty.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "TaskSize": {
      "description": "Context-budget size class for one roadmap task.\n\nThe contract is qualitative, not a token count: an `S`/`M` task fits one\nfresh agent session comfortably; `L` is the upper bound and a planner\nsignal to consider splitting.",
      "oneOf": [
        {
          "description": "Small — a focused change, well under one session.",
          "type": "string",
          "const": "s"
        },
        {
          "description": "Medium — a typical task, fits one session with room for verification.",
          "type": "string",
          "const": "m"
        },
        {
          "description": "Large — fills one session; anything bigger must be split.",
          "type": "string",
          "const": "l"
        }
      ]
    },
    "RoadmapDependency": {
      "description": "Directed dependency between roadmap milestones.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Milestone that must finish first.",
          "type": "string"
        },
        "to": {
          "description": "Milestone that depends on `from`.",
          "type": "string"
        },
        "reason": {
          "description": "Human-readable reason for the dependency.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "RoadmapRisk": {
      "description": "Risk tracked by the roadmap artifact.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Risk description.",
          "type": "string"
        },
        "mitigation": {
          "description": "Optional mitigation plan.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "description"
      ]
    }
  },
  "required": [
    "schema_version"
  ],
  "$id": "https://surge.dev/schema/v1/roadmap.json",
  "x-surge-schema-version": 1
}
